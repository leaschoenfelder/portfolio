---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Review from '../components/Review.astro';
import { samples, getProject, site, fmt, sampleSecs, totalSecs } from '../content/site';

const items = samples.items.map((s, i) => ({
  ...s,
  n: String(i + 1).padStart(2, '0'),
  project: getProject(s.slug),
  length: fmt(sampleSecs(s)),
}));
const total = fmt(totalSecs(samples.items));
const isPortrait = (aspect: string) => {
  const [w, h] = aspect.split('/').map((n) => parseFloat(n));
  return w / h < 1;
};
---
<Base title="Selected Work Samples" description={samples.sub}>
  <header class="wrap s-head">
    <p class="eyebrow">{samples.note}</p>
    <h1>{samples.headline}</h1>
    <p class="lede">{samples.sub}</p>

    <ol class="index" aria-label="Viewing sequence">
      {items.map((s) => (
        <li>
          <a href={`#sample-${s.slug}`}>
            <span class="idx-n">{s.n}</span>
            <span class="idx-title">{s.project.title}</span>
            <span class="idx-year">{s.project.year}</span>
            <span class="idx-dur">{s.length}</span>
          </a>
        </li>
      ))}
      <li class="idx-total">
        <span>Total viewing time</span><span>{total} min</span>
      </li>
    </ol>
    <Review id="samples" />
  </header>

  {items.map((s) => (
    <section id={`sample-${s.slug}`} class="wrap sample" aria-labelledby={`t-${s.slug}`}>
      <div class="sample-info">
        <p class="meta"><span>{s.n}</span><span>{s.length} min</span></p>
        <h2 id={`t-${s.slug}`}>{s.project.title} <span class="s-year">{s.project.year}</span></h2>
        <p>{s.framing}</p>
        <p class="credit">{s.role}</p>
        <a class="link-arrow" href={`/work/${s.slug}`}>Full project page</a>
        {s.slug === 'try-again' && (
          <p class="optional">
            Optional, outside the timed selection:<br />
            <a class="link-arrow" href={site.tryAgainPrototype} target="_blank" rel="noopener">Play the Prototype</a>
          </p>
        )}
      </div>
      <div class="sample-clips">
        {s.clips.map((c, i) => (
          <div class:list={['clip', isPortrait(c.aspect) && 'portrait']}>
            <p class="clip-label">
              {s.clips.length > 1 && <span>{String.fromCharCode(97 + i)}.</span>}
              {c.caption?.replace(/\.$/, '')} <span class="clip-dur">{c.duration}</span>
            </p>
            <Media media={{ ...c, caption: undefined }} />
          </div>
        ))}
      </div>
    </section>
  ))}
</Base>

<style>
  .s-head { padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 5vw, 4rem); }
  .s-head h1 { font-size: var(--fs-hero); margin: 1rem 0 1.5rem; }

  .index { list-style: none; padding: 0; margin: 3rem 0 0; max-width: 44rem; }
  .index li { border-top: 1px solid var(--line); }
  .index a {
    display: grid; grid-template-columns: 2.5rem 1fr auto 4rem; gap: 1rem;
    padding: 0.85rem 0; text-decoration: none; align-items: baseline;
  }
  .index a:hover .idx-title { color: var(--accent); }
  .idx-n, .idx-year { color: var(--muted); font-size: 0.875rem; }
  .idx-title { font-family: var(--serif); font-size: 1.5rem; line-height: 1.1; }
  .idx-dur { text-align: right; font-variant-numeric: tabular-nums; }
  .idx-total {
    display: flex; justify-content: space-between; padding: 0.85rem 0;
    border-bottom: 1px solid var(--line); font-weight: 600;
  }

  .sample {
    display: grid; grid-template-columns: 4fr 8fr; gap: calc(var(--gutter) * 1.5);
    align-items: start;
    padding-block: clamp(3rem, 7vw, 5.5rem);
    border-top: 1px solid var(--line);
  }
  .sample-info { position: sticky; top: 5.5rem; }
  .sample h2 { font-size: var(--fs-h3); margin: 0.8rem 0 1.25rem; }
  .s-year { font-family: var(--sans); font-size: var(--fs-small); color: var(--muted); }
  .sample .credit { margin-bottom: 1.5rem; }
  .optional { margin-top: 2rem; font-size: 0.875rem; color: var(--muted); }
  .optional .link-arrow { color: var(--fg); margin-top: 0.4rem; }

  .sample-clips { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .clip.portrait { max-width: 400px; }
  .clip-label { font-size: 0.875rem; margin-bottom: 0.6rem; display: flex; gap: 0.5em; align-items: baseline; }
  .clip-label > span:first-child { color: var(--muted); }
  .clip-dur { color: var(--muted); font-variant-numeric: tabular-nums; margin-left: auto; }

  @media (max-width: 760px) {
    .sample { grid-template-columns: 1fr; }
    .sample-info { position: static; }
    .clip.portrait { max-width: 100%; }
    .index a { grid-template-columns: 2rem 1fr auto 3rem; }
  }
</style>
